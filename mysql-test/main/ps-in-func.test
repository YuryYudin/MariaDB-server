--echo #
--echo # MDEV-39518 Allow prepared statements in stored functions in assignment right hand
--echo #

--echo #
--echo # CONTAINS SQL is printed in SHOW, mysql.proc, I_S queries
--echo #

DELIMITER $$;
CREATE FUNCTION f1() RETURNS INT CONTAINS SQL
BEGIN
  RETURN 0;
END;
$$
DELIMITER ;$$
SHOW CREATE FUNCTION f1;
--replace_column 5 # 6 #
--query_vertical SHOW FUNCTION STATUS LIKE 'f1'
--query_vertical SELECT db, name, sql_data_access FROM mysql.proc WHERE name='f1' AND db='test'
--query_vertical SELECT ROUTINE_SCHEMA, ROUTINE_NAME, SQL_DATA_ACCESS FROM INFORMATION_SCHEMA.ROUTINES WHERE ROUTINE_NAME='f1' AND ROUTINE_SCHEMA='test'
DROP FUNCTION f1;

--echo #
--echo # CONTAINS SQL itself does not restrict use in SELECT list
--echo #

DELIMITER $$;
CREATE FUNCTION f1() RETURNS INT CONTAINS SQL
BEGIN
  RETURN 0;
END;
$$
DELIMITER ;$$
SELECT f1();
DROP FUNCTION f1;

--echo #
--echo # CONTAINS SQL + PREPARE/EXECUTE/DEALLOCATE restrict use in SELECT list
--echo #

DELIMITER $$;
CREATE FUNCTION f1() RETURNS INT CONTAINS SQL
BEGIN
  PREPARE stmt FROM 'INSERT INTO t1 VALUES (10)';
  RETURN 0;
END;
$$
DELIMITER ;$$
--error ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG
SELECT f1();
DROP FUNCTION f1;

DELIMITER $$;
CREATE FUNCTION f1() RETURNS INT CONTAINS SQL
BEGIN
  EXECUTE stmt;
  RETURN 0;
END;
$$
DELIMITER ;$$
--error ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG
SELECT f1();
DROP FUNCTION f1;

DELIMITER $$;
CREATE FUNCTION f1() RETURNS INT CONTAINS SQL
BEGIN
  EXECUTE IMMEDIATE 'INSERT INTO t1 VALUES (10)';
  RETURN 0;
END;
$$
DELIMITER ;$$
--error ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG
SELECT f1();
DROP FUNCTION f1;


DELIMITER $$;
CREATE FUNCTION f1() RETURNS INT CONTAINS SQL
BEGIN
  DEALLOCATE PREPARE stmt;
  RETURN 0;
END;
$$
DELIMITER ;$$
--error ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG
SELECT f1();
DROP FUNCTION f1;

--echo #
--echo # Prepare a statement outside of the function, open a cursor inside
--echo #

CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (10);
PREPARE stmt FROM 'SELECT MAX(a) FROM t1';

DELIMITER $$;
CREATE FUNCTION f1() RETURNS INT CONTAINS SQL
BEGIN
  DECLARE c0 SYS_REFCURSOR;
  DECLARE v0 INT;
  OPEN c0 FOR PREPARE stmt;
  FETCH c0 INTO v0;
  CLOSE c0;
  RETURN v0;
END;
$$
DELIMITER ;$$

--error ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG
SELECT f1();

# Assignment works
DELIMITER $$;
CREATE PROCEDURE p1()
BEGIN
  DECLARE n INT;
  SET n= f1();
  SELECT n;
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;

# DEFULT also works
DELIMITER $$;
CREATE PROCEDURE p1()
BEGIN
  DECLARE n INT DEFAULT f1();
  SELECT n;
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;

DROP FUNCTION f1;
DEALLOCATE PREPARE stmt;
DROP TABLE t1;


--echo #
--echo # Prepare a statement inside the function, open a cursor
--echo #

CREATE TABLE t1 (a INT);
INSERT INTO t1 VALUES (10);

DELIMITER $$;
CREATE FUNCTION f1() RETURNS INT CONTAINS SQL
BEGIN
  DECLARE c0 SYS_REFCURSOR;
  DECLARE v0 INT;
  PREPARE stmt FROM 'SELECT MAX(a) FROM t1';
  OPEN c0 FOR PREPARE stmt;
  FETCH c0 INTO v0;
  CLOSE c0;
  DEALLOCATE PREPARE stmt;
  RETURN v0;
END;
$$
DELIMITER ;$$

--error ER_STMT_NOT_ALLOWED_IN_SF_OR_TRG
SELECT f1();

# Assignment works
DELIMITER $$;
CREATE PROCEDURE p1()
BEGIN
  DECLARE n INT;
  SET n= f1();
  SELECT n;
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;

# DEFULT also works
DELIMITER $$;
CREATE PROCEDURE p1()
BEGIN
  DECLARE n INT DEFAULT f1();
  SELECT n;
END;
$$
DELIMITER ;$$
CALL p1;
DROP PROCEDURE p1;

DROP FUNCTION f1;
DROP TABLE t1;


--echo #
--echo # DML statements
--echo #

CREATE TABLE t1 (a INT);

DELIMITER $$;
CREATE FUNCTION f1(query TEXT) RETURNS INT CONTAINS SQL
BEGIN
  DECLARE nrows INT;
  PREPARE stmt FROM query;
  EXECUTE stmt;
  SET nrows= ROW_COUNT();
  DEALLOCATE PREPARE stmt;
  RETURN nrows;
END;
$$
CREATE PROCEDURE p1(query TEXT)
BEGIN
  DECLARE nrows INT;
  SET nrows= f1(query);
  SELECT nrows;
  SELECT * FROM t1;
END;
$$
DELIMITER ;$$
CALL p1('INSERT INTO t1 VALUES (10),(20),(30)');
CALL p1('UPDATE t1 SET a=a+1');
CALL p1('DELETE FROM t1 WHERE a>20');
DROP PROCEDURE p1;
DROP FUNCTION f1;
DROP TABLE t1;
