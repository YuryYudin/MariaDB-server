#
# MDEV-39518 Allow prepared statements in stored functions in assignment right hand
#
#
# CONTAINS SQL is printed in SHOW, mysql.proc, I_S queries
#
CREATE FUNCTION f1() RETURNS INT CONTAINS SQL
BEGIN
RETURN 0;
END;
$$
SHOW CREATE FUNCTION f1;
Function	sql_mode	Create Function	character_set_client	collation_connection	Database Collation
f1	STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION	CREATE DEFINER=`root`@`localhost` FUNCTION `f1`() RETURNS int(11)
    CONTAINS SQL
BEGIN
RETURN 0;
END	latin1	latin1_swedish_ci	utf8mb4_uca1400_ai_ci
SHOW FUNCTION STATUS LIKE 'f1';
