name	f1
sql_data_access	CONTAINS_SQL
SELECT ROUTINE_SCHEMA, ROUTINE_NAME, SQL_DATA_ACCESS FROM INFORMATION_SCHEMA.ROUTINES WHERE ROUTINE_NAME='f1' AND ROUTINE_SCHEMA='test';
ROUTINE_SCHEMA	test
ROUTINE_NAME	f1
